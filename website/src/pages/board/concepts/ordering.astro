---
import { getCollection, render } from 'astro:content';
import ThreadLayout from '../../../layouts/ThreadLayout.astro';
import { threadData } from '../../_thread/thread';

const docs = await getCollection('docs');
const entry = docs.find((candidate) => candidate.id === 'concepts/ordering');
if (entry === undefined) {
	throw new Error('docs entry "concepts/ordering" not found');
}
const { Content } = await render(entry);
const thread = threadData(entry, docs);

// the sidebar's Concepts order ends on this thread -- routing precedes it,
// nothing follows; the generalized route derives this in the next slice
const previous = { title: 'Routing', href: '/concepts/routing/' };
const next = null;
---

<ThreadLayout
	title={entry.data.title}
	description={entry.data.description ?? entry.data.title}
	boardTitle={thread.board.title}
	boardHref={thread.board.href}
	editHref={thread.editHref}
	postedDate={thread.postedDate}
	reportHref={thread.reportHref}
	postCount={thread.postCount}
	previous={previous}
	next={next}
>
	<Content />
</ThreadLayout>

---
import { getCollection } from 'astro:content';
import BoardLayout from '../layouts/BoardLayout.astro';
import BoardSection from '../components/board-section/board-section.svelte';
import BoardRow from '../components/board-row/board-row.svelte';
import StickyRow from '../components/sticky-row/sticky-row.svelte';
import { boardRows, stickyRows } from './_board/rows';

const docs = await getCollection('docs');
const rows = boardRows(docs);
const stickies = stickyRows(docs);
---

<BoardLayout
	title="Vulkan Board Index"
	description="The message platform forged in Postgres. Queue, event log, and router in one system."
	navCurrent="Board Index"
>
	<div class="board-index">
		<BoardSection title="Start Here" columnLabels={null} threadCount={stickies.length}>
			{
				stickies.map((sticky) => (
					<StickyRow
						title={sticky.title}
						href={sticky.href}
						updated={false}
						lastUpdatedDate={sticky.lastUpdatedDate}
					/>
				))
			}
		</BoardSection>
		<BoardSection
			title="Board"
			columnLabels={{ threadCount: 'Threads', lastPost: 'Last post' }}
			threadCount={null}
		>
			{
				rows.map((row, index) => (
					<BoardRow
						index={index}
						title={row.title}
						href={row.href}
						description={row.description}
						threadCount={row.threadCount}
						lastPostTitle={row.lastPostTitle}
						lastPostHref={row.lastPostHref}
						lastPostDate={row.lastPostDate}
						updated={false}
					/>
				))
			}
		</BoardSection>
	</div>
</BoardLayout>

<style>
	.board-index {
		padding: 18px 20px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
</style>

---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import ThreadLayout from '../layouts/ThreadLayout.astro';
import { boards, boardHref, isErrorThread } from './_board/boards';
import { boardEntries } from './_board/rows';
import { threadData } from './_thread/thread';

export const getStaticPaths = (async () => {
	const docs = await getCollection('docs');

	// every board thread except the error threads -- those render
	// through errors/[code].astro
	return boards
		.flatMap((board) => boardEntries(board, docs))
		.filter((entry) => !isErrorThread(entry.id))
		.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const docs = await getCollection('docs');
const { Content } = await render(entry);
const thread = threadData(entry, docs);
---

<ThreadLayout
	title={entry.data.title}
	description={entry.data.description ?? entry.data.title}
	boardTitle={thread.board.title}
	boardHref={boardHref(thread.board)}
	editHref={thread.editHref}
	postedDate={thread.postedDate}
	reportHref={thread.reportHref}
	postCount={thread.postCount}
	previous={thread.previous}
	next={thread.next}
>
	<Content />
</ThreadLayout>

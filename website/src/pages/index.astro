---
import { getCollection } from 'astro:content';
import BoardLayout from '../layouts/BoardLayout.astro';
import Breadcrumb from '../components/breadcrumb/breadcrumb.svelte';
import BoardSection from '../components/board-section/board-section.svelte';
import BoardRows from '../components/board-rows/board-rows.svelte';
import StickyRows from '../components/sticky-rows/sticky-rows.svelte';
import ThreadPost from '../components/thread-post/thread-post.svelte';
import SqlConsole from '../components/sql-console/sql-console.svelte';
import AnnouncementRow from '../components/announcement-row/announcement-row.svelte';
import BoardStats from '../components/board-stats/board-stats.svelte';
import JumpTo from '../components/jump-to/jump-to.svelte';
import { jumpTargets } from './_board/boards';
import { boardRows, stickyRows } from './_board/rows';
import { announcements } from './_board/announcements';
import { siteStats } from './_board/stats';
import { consoleLabel, consoleShell } from './_board/console';

const docs = await getCollection('docs');
const rows = boardRows(docs);
const stickies = stickyRows(docs);
const stats = siteStats(docs);
const shell = await consoleShell();
---

<BoardLayout
	title="Vulkan Board Index"
	description="The message platform forged in Postgres. Queue, event log, and router in one system."
	navCurrent="Board Index"
>
	<Breadcrumb trail={[{ label: 'Board Index', href: '/' }]} />
	<BoardSection title="Start Here" columnLabels={null} threadCount={stickies.length}>
		<StickyRows client:idle stickies={stickies} />
		<ThreadPost author="brandon" role="Site Admin" header={null} postCount={null} actions={null}>
			<p>
				Every queue makes you trust its dashboard. Vulkan is Postgres, so you can just look — the
				tables below are the ones the library creates, seeded through its own produce statement.
				Edit the SQL and press Run: the database runs in this tab, and nothing leaves your
				browser.
			</p>
			<SqlConsole
				client:visible
				label={consoleLabel}
				sql={shell.sql}
				columns={shell.columns}
				rows={shell.rows}
			/>
		</ThreadPost>
	</BoardSection>
	<BoardSection
		title="Board"
		columnLabels={{ threadCount: 'Threads', lastPost: 'Last post' }}
		threadCount={null}
	>
		<BoardRows client:idle rows={rows} />
	</BoardSection>
	<BoardSection title="Announcements" columnLabels={null} threadCount={null}>
		{
			announcements.map((announcement, index) => (
				<AnnouncementRow
					index={index}
					title={announcement.title}
					href={announcement.href}
					date={announcement.date}
				/>
			))
		}
	</BoardSection>
	<BoardStats
		threadCount={stats.threadCount}
		codeCount={stats.codeCount}
		decisionRecordCount={stats.decisionRecordCount}
	/>
	<JumpTo client:idle targets={jumpTargets} />
</BoardLayout>

---
import BoardLayout from './BoardLayout.astro';
import Breadcrumb from '../components/breadcrumb/breadcrumb.svelte';
import ThreadTitleBand from '../components/thread-title-band/thread-title-band.svelte';
import CodeFacts from '../components/code-facts/code-facts.svelte';
import ErrorPost from '../components/error-post/error-post.svelte';
import LogLine from '../components/log-line/log-line.svelte';
import ThreadPost from '../components/thread-post/thread-post.svelte';
import CopyButton from '../components/copy-button/copy-button.svelte';
import SearchStrip from '../components/search-strip/search-strip.svelte';
import PrevNext from '../components/prev-next/prev-next.svelte';
import JumpTo from '../components/jump-to/jump-to.svelte';
import { jumpTargets } from '../pages/_board/boards';
import type { ThreadLink } from '../components/prev-next/types';
import type { CodeThreadData } from '../pages/_thread/model';

type Props = {
	title: string;
	description: string;
	boardTitle: string;
	boardHref: string;
	editHref: string;
	postedDate: string;
	reportHref: string;
	postCount: number;
	previous: ThreadLink | null;
	next: ThreadLink | null;
	codeThread: CodeThreadData;
};

const {
	title,
	description,
	boardTitle,
	boardHref,
	editHref,
	postedDate,
	reportHref,
	postCount,
	previous,
	next,
	codeThread,
} = Astro.props;

const trail = [
	{ label: 'Board Index', href: '/' },
	{ label: boardTitle, href: boardHref },
	{ label: `${title} [${codeThread.code}]`, href: null },
];
const returnTrail = [
	{ label: 'Board Index', href: '/' },
	{ label: boardTitle, href: boardHref },
];
const threadUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<BoardLayout
	title={`${title} [${codeThread.code}]`}
	description={description}
	navCurrent="Troubleshooting"
>
	<div class="thread-top">
		<Breadcrumb trail={trail} />
		<div class="adjacent-links">
			{previous !== null && <a href={previous.href}>View previous thread</a>}
			{previous !== null && next !== null && <span>::</span>}
			{next !== null && <a href={next.href}>View next thread</a>}
		</div>
	</div>
	<!-- Pagefind indexes only elements marked data-pagefind-body -->
	<div class="search-region" data-pagefind-body>
		<ThreadTitleBand
			title={title}
			code={codeThread.code}
			solved={codeThread.solved}
			editHref={editHref}
		/>
		<CodeFacts
			code={codeThread.code}
			classification={codeThread.classification}
			consequence={codeThread.consequence}
		/>
		<ErrorPost code={codeThread.code} rank={codeThread.rank} reportHref={reportHref} actions={null}>
			<CopyButton client:idle slot="actions" label="Copy link" text={threadUrl} />
			<p>{codeThread.introduction}</p>
			<LogLine text={codeThread.logLine} kind={codeThread.kind} />
			<div class="thread-body">
				<slot />
			</div>
		</ErrorPost>
		{
			codeThread.fix !== null && (
				<ThreadPost
					author="brandon"
					role="Site Admin"
					header={{ kind: 'accepted', postedDate }}
					postCount={postCount}
					actions={null}
				>
					<p>
						<strong>{codeThread.fix}</strong>
					</p>
				</ThreadPost>
			)
		}
	</div>
	<SearchStrip exampleText={codeThread.logLine} />
	<PrevNext previous={previous} next={next} />
	<div class="thread-return">
		<Breadcrumb trail={returnTrail} />
		<JumpTo client:idle targets={jumpTargets} />
	</div>
</BoardLayout>

<style>
	.thread-top {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
	}

	.adjacent-links {
		font-size: 10px;
		color: var(--color-text-faint);
		display: flex;
		gap: 6px;
	}

	.adjacent-links a {
		font-size: 10px;
	}

	.thread-return {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	/* mirrors the page-content gap so the wrapper is invisible in the flow */
	.search-region {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
</style>

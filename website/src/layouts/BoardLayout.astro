---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import BoardBanner from '../components/board-banner/board-banner.svelte';
import BoardNav from '../components/board-nav/board-nav.svelte';
import SiteNotice from '../components/site-notice/site-notice.svelte';
import CookieNotice from '../components/cookie-notice/cookie-notice.svelte';
import TrackedVisitBar from '../components/tracked-visit-bar/tracked-visit-bar.svelte';
import BoardFooter from '../components/board-footer/board-footer.svelte';
import { siteUrl, docsVersion } from '../site';

type Props = {
	title: string;
	description: string;
	navCurrent: string | null;
};

const { title, description, navCurrent } = Astro.props;

// on a frozen version deployment the canonical still names the live
// origin, so search engines index one copy of every page
const canonicalHref = new URL(Astro.url.pathname, siteUrl).href;
const versionManifestHref = new URL('/versions.json', siteUrl).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalHref} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
		/>
		<ClientRouter />
		<script is:inline>
			// The board style has to be on <html> before the first paint, or the
			// page renders classic and repaints. It is put back after every soft
			// navigation too: ClientRouter's swap copies the incoming document's
			// <html> attributes, and the incoming document is the static build,
			// which carries none. Storage is re-read each time so a style chosen
			// in the footer survives the next navigation. Until a reader chooses,
			// the operating system's preference picks the opening style.
			(() => {
				const readStyle = () => {
					try {
						const stored = window.localStorage.getItem('vulkan-board:style');
						if (stored !== null) return stored;
					} catch {
						// storage denied -- the preference below decides every load
					}
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'classic';
				};

				const applyStyle = () => {
					document.documentElement.dataset.boardStyle = readStyle();
				};

				applyStyle();
				document.addEventListener('astro:after-swap', applyStyle);
			})();
		</script>
		<script>
			// bundled on purpose, never is:inline: a bundled module runs once for
			// the whole visit and its window listeners survive ClientRouter swaps
			import { listenForPageFailures } from '../state/site-notice.svelte';
			listenForPageFailures();
		</script>
	</head>
	<body>
		<SiteNotice client:idle />
		<div class="page-frame">
			<BoardBanner />
			<BoardNav current={navCurrent} />
			<TrackedVisitBar client:idle version={docsVersion} manifestUrl={versionManifestHref} />
			<div class="page-content">
				<slot />
			</div>
			<BoardFooter client:idle />
		</div>
		<CookieNotice client:idle />
	</body>
</html>

<style>
	.page-frame {
		width: min(1080px, calc(100% - 32px));
		margin: var(--space-32) auto;
		background: var(--color-surface);
		border: 1px solid var(--border-outer);
		box-shadow: var(--shadow-page-frame);
	}

	.page-content {
		padding: var(--space-18) var(--space-20);
		display: flex;
		flex-direction: column;
		gap: var(--space-20);
	}

	/* below the collapse the frame's gutters shrink: a phone cannot
	   spare 72px of the row to margins and padding */
	@media (max-width: 639px) {
		.page-frame {
			width: calc(100% - 16px);
			margin: var(--space-16) auto;
		}

		.page-content {
			padding: var(--space-12);
			gap: var(--space-16);
		}
	}
</style>

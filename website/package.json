{
	"name": "website",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build && pagefind --site dist",
		"preview": "astro preview",
		"astro": "astro",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"lint": "eslint .",
		"test": "vitest run",
		"format": "prettier --write .",
		"verify": "prettier --check . && eslint . && stylelint \"src/**/*.css\" && astro check && svelte-check --threshold error && remark src/content/docs --ext md,mdx --quiet --frail && vale --minAlertLevel=error src/content/docs && vitest run"
	},
	"dependencies": {
		"@astrojs/mdx": "^7.0.7",
		"@astrojs/svelte": "^9.0.1",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.9",
		"@electric-sql/pglite": "^0.5.6",
		"@lezer/highlight": "^1.2.3",
		"astro": "^7.2.4",
		"sharp": "^0.34.5",
		"svelte": "^5.56.10"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@eslint/js": "^10.0.1",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/svelte-vite": "^10.5.10",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@vvago/vale": "^3.17.1",
		"eslint": "^10.9.0",
		"eslint-plugin-astro": "^1.7.0",
		"eslint-plugin-svelte": "^3.23.0",
		"mdx2vast": "^0.5.0",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-svelte": "^4.1.1",
		"remark-cli": "^12.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-lint-first-heading-level": "^4.0.1",
		"remark-lint-heading-increment": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"storybook": "^10.5.10",
		"stylelint": "^17.14.1",
		"stylelint-declaration-strict-value": "^1.11.1",
		"svelte-check": "^4.7.6",
		"svelte-preprocess": "^6.0.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^6.4.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.100.0"
	}
}
